{
  "version": 3,
  "build": {
    "env": {}
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/[...path].ts" },
    { "handle": "filesystem" },
    {
      "src": "/(.*\\.(?:js|css|png|jpg|jpeg|svg|ico|map|json|txt|xml))$",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/dist/public/$1"
    },
    { "src": "/(.*)", "dest": "/dist/public/index.html" }
  ],
  "functions": {
    "api/**/*.ts": {
      "runtime": "nodejs18.x",
      "maxDuration": 10
    }
  }
}
